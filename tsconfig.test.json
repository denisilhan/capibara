{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-output",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "tests/*.test.ts",
    "src/types/**/*.ts",
    "src/data/**/*.ts",
    "src/lib/**/*.ts"
  ]
}
